{
  "name": "evmod-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --bun vite",
    "check": "bun check -p tsconfig.json",
    "build": "bun run check && bun --bun vite build && bun scripts/generate-route-indexes.mjs",
    "build:dev": "bun run check && bun --bun vite build --mode development && bun scripts/generate-route-indexes.mjs",
    "sync:map-colors": "bun scripts/sync-map-colors.mjs",
    "preview": "bun --bun vite preview"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "pako": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}