{
	"required": true,
	"package": "net.evmodder.evmod.mixin",
	"compatibilityLevel": "${java_compatibility}",
	"mixins": [
		// EvMod access bridges:
		"AccessorClickUtils",  // Automated click accounting
		"AccessorCommandPearlRescue",  // Player-info packet callback
		"AccessorEpearlLookup",  // Server-time and connection lifecycle callbacks
		"AccessorKeybindCraftingRestock",  // Crafting action and inventory packet callbacks
		"AccessorUpdateContainerContents",  // Custom container title
		"AccessorMain",  // Feature instances owned by Main
		"AccessorMapGroupUtils",  // Loaded-map bookkeeping
		"AccessorUpdateItemFrameContents",  // Item-frame highlight and render caches

		// Minecraft mixins:
		"AccessorAnvilScreen",
		"AccessorPlayerTabOverlay",
		"AccessorProjectile",
		"MixinAnvilScreen",
		"MixinMultiPlayerGameMode",
		"MixinClientPacketListener",
		"MixinClientLevel",
		"MixinEntityRendererPearl",
		"MixinAbstractContainerScreenGhostItems",
		"MixinHudMap",
		"MixinItemFrameRenderer",
		"${level_entity_visibility_mixin}",
//		"MixinItemModelManager",
		"MixinAbstractContainerMenu",

		// MaLiLib mixins:
		"AccessorWidgetListConfigOptions",
		"MixinWidgetConfigOption"
//		"MixinWidgetListConfigOptions"
	],
	"injectors": { "defaultRequire": 1 }
}